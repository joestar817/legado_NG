<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/layout_engine_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh_engines"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_engines"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_engine_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/ng_page_padding"
        android:paddingTop="@dimen/ng_space_l"
        android:paddingEnd="@dimen/ng_page_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_detail_title"
            style="@style/Ng.CardTitle"
            android:ellipsize="end"
            android:singleLine="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/scroll_config"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scroll_config_form"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/layout_config_form_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_config_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent" />

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/layout_config_actions"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:background="@android:color/transparent" />

                </LinearLayout>

            </ScrollView>

            <LinearLayout
                android:id="@+id/layout_script_editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <io.legado.app.ui.widget.code.CodeView
                    android:id="@+id/edit_script_code"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/ng_bg_outlined_field"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minHeight="220dp"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/ng_on_surface"
                    android:textSize="15sp" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_voices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_voice_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh_voices"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_voices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_engine_detail_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/ng_space_s"
            android:background="@android:color/transparent" />

    </LinearLayout>

</FrameLayout>
