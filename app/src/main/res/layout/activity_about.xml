<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="io.legado.app.ui.about.AboutActivity">

    <View
        android:id="@+id/ng_liquid_glass_backdrop_source"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.legado.app.ui.widget.TitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/about">

            <LinearLayout
                android:id="@+id/ll_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ng_page_padding"
                android:layout_marginEnd="@dimen/ng_page_padding"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="18dp">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="@string/app_name_ng"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    style="@style/Ng.Title"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_name_ng"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/ng_bg_settings_icon"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/ng_primary"
                    android:textSize="12sp"
                    tools:text="3.26.080415debug" />

                <TextView
                    android:id="@+id/tv_app_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/about_description_ng"
                    android:textColor="@color/ng_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>

        </io.legado.app.ui.widget.TitleBar>

        <FrameLayout
            android:id="@+id/fl_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</FrameLayout>
