<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_ai_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_providers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_provider_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_skill_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_skill_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_purify_model_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_read_aloud_model_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_assistant_model_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_purify_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

</FrameLayout>
